{
  "name": "@_linked/live-sessions",
  "version": "0.1.0",
  "description": "Transport-neutral, policy-supplied live session admission and lifecycle contracts for Linked applications",
  "linkedPackage": true,
  "type": "module",
  "license": "ISC",
  "repository": { "type": "git", "url": "git+https://github.com/linked-fw/live-sessions.git" },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package": { "types": "./dist/package.d.ts", "import": "./dist/package.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": { "@_linked/core": "^2.22.2" },
  "devDependencies": { "typescript": "5.9.2" },
  "publishConfig": { "access": "public" }
}
